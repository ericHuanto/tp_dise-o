{{#partial "nombre_pestaña"}}
    Gestión de Camiones - DonaTrack
{{/partial}}
{{#partial "contenido_propio"}}
    <section>
        <h2>Administración de Camiones</h2>
        <div>
            <a href="/camiones/nuevo"><button>Registrar Camión Nuevo</button></a>
        </div>
        <table>
            <thead>
            <tr>
                <th>Patente</th>
                <th>Volumen (m³)</th>
                <th>Altura (m)</th>
                <th>Carga (kg)</th>
                <th>GPS (IMEI)</th>
                <th>Acciones</th>
            </tr>
            </thead>
            <tbody>
            {{#each camiones}}
                <tr>
                    <td>{{this.patente}}</td>
                    <td>{{this.capacidadVolumen}}</td>
                    <td>{{this.altura}}</td>
                    <td>{{this.capacidadCarga}}</td>
                    <td>{{#if this.gpsImei}}{{this.gpsImei}}{{else}}Sin asignar{{/if}}</td>
                    <td>
                        <a href="/camiones/{{this.patente}}/edicion">Editar</a>
                        <form action="/camiones/{{this.patente}}/eliminacion" method="POST">
                            <button type="submit">Eliminar</button>
                        </form>
                    </td>
                </tr>
            {{else}}
                <tr><td colspan="6">No hay camiones registrados.</td></tr>
            {{/each}}
            </tbody>
        </table>
    </section>
{{/partial}}
{{> plantillas/layout.hbs}}