{{#partial "nombre_pestaña"}}
    Editar Camión - DonaTrack
{{/partial}}

{{#partial "contenido_propio"}}
    <section>
        <h2>Editar Camión: {{camion.patente}}</h2>
        <form action="/camiones/{{camion.patente}}/edicion" method="POST">
            <div>
                <label for="patente">Patente (No modificable):</label><br>
                <input type="text" id="patente" name="patente" value="{{camion.patente}}" readonly>
            </div>
            <div>
                <label for="capacidadVolumen">Capacidad de Volumen (m³):</label><br>
                <input type="number" step="0.01" id="capacidadVolumen" name="capacidad_volumen" value="{{camion.capacidadVolumen}}" >
            </div>
            <div>
                <label for="altura">Altura (m):</label><br>
                <input type="number" step="0.01" id="altura" name="altura" value="{{camion.altura}}" >
            </div>
            <div>
                <label for="capacidadCarga">Capacidad de Carga (kg):</label><br>
                <input type="number" step="0.01" id="capacidadCarga" name="capacidad_carga" value="{{camion.capacidadCarga}}" >
            </div>
            <div>
                <label for="gpsImei">IMEI del GPS Asignado:</label><br>
                <input type="text" id="gpsImei" name="gps_imei" value="{{camion.gpsImei}}">
            </div>
            <div>
                <button type="submit">Actualizar Datos</button>
                <a href="/camiones">Cancelar</a>
            </div>
        </form>
    </section>
{{/partial}}
{{> plantillas/layout.hbs}}