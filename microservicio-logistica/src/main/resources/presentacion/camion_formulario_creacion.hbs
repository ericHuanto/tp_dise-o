{{#partial "nombre_pestaña"}}
    Nuevo Camión - DonaTrack
{{/partial}}

{{#partial "contenido_propio"}}
    <section>
        <h2>Registrar Nuevo Camión</h2>
        <form action="/camiones" method="POST">
            <div>
                <label for="patente">Patente:</label><br>
                <input type="text" id="patente" name="patente" required>
            </div>
            <div>
                <label for="capacidadVolumen">Capacidad de Volumen (m³):</label><br>
                <input type="number" step="0.01" id="capacidadVolumen" name="capacidad_volumen" required>
            </div>
            <div>
                <label for="altura">Altura (m):</label><br>
                <input type="number" step="0.01" id="altura" name="altura" required>
            </div>
            <div>
                <label for="capacidadCarga">Capacidad de Carga (kg):</label><br>
                <input type="number" step="0.01" id="capacidadCarga" name="capacidad_carga" required>
            </div>
            <div>
                <button type="submit">Guardar Camión</button>
                <a href="/camiones" >Cancelar</a>
            </div>
        </form>
    </section>
{{/partial}}
{{> plantillas/layout.hbs}}