{{#partial "nombre_pestaña"}}
    Gestión de Camiones - DonaTrack
{{/partial}}

{{#partial "contenido_propio"}}
    <div style="background-color: #f7f6f2; min-height: 100vh; padding: 40px 30px; font-family: Arial, sans-serif; color: #1a1a1a;">

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
            <h1 style="font-size: 2em; margin: 0; letter-spacing: -0.5px;">Camiones</h1>
            <a href="/camiones/nuevo" style="background-color: #1a1a1a; color: white; padding: 10px 20px; text-decoration: none; border-radius: 6px; font-weight: bold; font-size: 0.9em;">
                + Registrar Camión
            </a>
        </div>

        <!-- Métricas (KPIs) -->
        <div style="display: flex; gap: 20px; margin-bottom: 30px;">
            <div style="background-color: #eae6df; padding: 20px; border-radius: 8px; flex: 1;">
                <div style="font-size: 2.5em; font-weight: bold; margin-bottom: 5px;">{{totalCamiones}}</div>
                <div style="color: #666; font-size: 0.9em;">Camiones Totales</div>
            </div>
            <div style="background-color: #eae6df; padding: 20px; border-radius: 8px; flex: 1;">
                <div style="font-size: 2.5em; font-weight: bold; margin-bottom: 5px;">{{camionesEnRuta}}</div>
                <div style="color: #666; font-size: 0.9em;">Camiones en Ruta ahora</div>
            </div>
            <div style="background-color: #eae6df; padding: 20px; border-radius: 8px; flex: 1;">
                <div style="font-size: 2.5em; font-weight: bold; margin-bottom: 5px;">{{camionesSinGps}}</div>
                <div style="color: #666; font-size: 0.9em;">Camiones sin GPS instalado</div>
            </div>
        </div>

        <div style="background-color: white; border-radius: 12px; border: 1px solid #eaeaea; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9em;">
                <thead style="background-color: #fbfaf9; color: #777; font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.5px;">
                <tr>
                    <th style="padding: 15px 20px; border-bottom: 1px solid #eaeaea;">Patente</th>
                    <th style="padding: 15px 20px; border-bottom: 1px solid #eaeaea;">Carga</th>
                    <th style="padding: 15px 20px; border-bottom: 1px solid #eaeaea;">Volumen</th>
                    <th style="padding: 15px 20px; border-bottom: 1px solid #eaeaea;">Altura</th>
                    <th style="padding: 15px 20px; border-bottom: 1px solid #eaeaea;">GPS (IMEI)</th>
                    <th style="padding: 15px 20px; border-bottom: 1px solid #eaeaea;">Ubicación Actual</th>
                    <th style="padding: 15px 20px; border-bottom: 1px solid #eaeaea; text-align: right;">Acciones</th>
                </tr>
                </thead>
                <tbody>
                {{#each camiones}}
                    <tr style="border-bottom: 1px solid #eaeaea; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#fcfdfc'" onmouseout="this.style.backgroundColor='transparent'">
                        <td style="padding: 15px 20px; font-weight: bold; font-family: monospace; font-size: 1.1em;">{{this.patente}}</td>
                        <td style="padding: 15px 20px;">{{this.capacidadCarga}} kg</td>
                        <td style="padding: 15px 20px;">{{this.capacidadVolumen}} m³</td>
                        <td style="padding: 15px 20px;">{{this.altura}} m</td>
                        <td style="padding: 15px 20px;">
                            {{#if this.imeiGps}}
                                {{this.imeiGps}}
                            {{else}}
                                <span style="font-weight: bold;">Sin GPS</span>
                            {{/if}}
                        </td>
                        <td class="celda-ubicacion" data-lat="{{this.ultimaLatitud}}" data-lng="{{this.ultimaLongitud}}" style="padding: 15px 20px; color: #555;">
                            ...
                        </td>
                        <td style="padding: 15px 20px; text-align: right; display: flex; gap: 15px; justify-content: flex-end; align-items: center;">
                            <a href="/camiones/{{this.patente}}/edicion" title="Editar camión" style="color: #5f6368; transition: color 0.2s; display: flex; align-items: center;" onmouseover="this.style.color='#1a73e8'" onmouseout="this.style.color='#5f6368'">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                            </a>
                            <form action="/camiones/{{this.patente}}/eliminacion" method="post" style="margin: 0; display: flex; align-items: center;">
                                <button type="submit" title="Eliminar camión" style="background: none; border: none; color: #5f6368; cursor: pointer; padding: 0; display: flex; align-items: center; transition: color 0.2s;" onmouseover="this.style.color='#d93025'" onmouseout="this.style.color='#5f6368'">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                {{else}}
                    <tr>
                        <td colspan="7" style="padding: 30px; text-align: center; color: #777;">No hay camiones registrados en el sistema.</td>
                    </tr>
                {{/each}}
                </tbody>
            </table>
        </div>
    </div>
{{/partial}}

{{#partial "scripts"}}
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const celdas = document.querySelectorAll(".celda-ubicacion");

            celdas.forEach(celda => {
                const lat = celda.getAttribute("data-lat");
                const lng = celda.getAttribute("data-lng");

                if (lat && lng && lat !== "null" && lng !== "null") {
                    fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`)
                            .then(response => response.json())
                            .then(data => {
                                celda.innerText = data.address.road ?
                                        `${data.address.road} ${data.address.house_number || ''}, ${data.address.city || data.address.town}` :
                                        data.display_name.split(",")[0];
                            })
                            .catch(() => {
                                celda.innerText = "Error al cargar dirección";
                            });
                } else {
                    celda.innerText = "Sin ubicación";
                }
            });
        });
    </script>
{{/partial}}

{{> partials/layout.hbs}}