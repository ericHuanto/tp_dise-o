{{#partial "nombre_pestaña"}}
    Editar Camión - DonaTrack
{{/partial}}

{{#partial "contenido_propio"}}
    <div style="background-color: #f7f6f2; min-height: 100vh; padding: 40px 30px; font-family: Arial, sans-serif; color: #1a1a1a; display: flex; justify-content: center;">
        <div style="display: flex; gap: 40px; max-width: 1200px; width: 100%; align-items: flex-start; flex-wrap: wrap;">

            <section style="flex: 3; min-width: 300px;">
                <h2 style="font-size: 1.5em; margin-bottom: 20px; letter-spacing: -0.5px;">Última ubicación</h2>
                <div style="width: 100%; height: 400px; border-radius: 8px; overflow: hidden; margin-bottom: 15px; background-color: #eae6df;">
                    <iframe id="mapa-camion" width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0"></iframe>
                </div>
            </section>

            <section style="flex: 1; min-width: 300px; background-color: white; border-radius: 12px; padding: 30px; border: 1px solid #eaeaea; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                <div style="margin-bottom: 25px; border-bottom: 1px solid #f0f0f0; padding-bottom: 15px;">
                    <h2 style="font-size: 1.3em; margin: 0 0 5px 0;">Editar camión</h2>
                    <span style="color: #777; font-family: monospace; font-size: 0.9em; letter-spacing: 1px;">{{camion.patente}}</span>
                </div>

                <form action="/camiones/{{camion.patente}}/edicion" method="POST" style="display: flex; flex-direction: column; gap: 20px;">
                    <div>
                        <label for="patente" style="display: block; font-size: 0.85em; color: #555; margin-bottom: 8px;">Patente (No modificable)</label>
                        <input type="text" id="patente" name="patente" value="{{camion.patente}}" readonly
                               style="width: 100%; padding: 12px 15px; border: 1px solid #e0e0e0; border-radius: 6px; background-color: #f7f6f2; color: #555; font-family: monospace; font-size: 1em; box-sizing: border-box; outline: none; cursor: not-allowed;">
                    </div>
                    <div>
                        <label for="capacidadCarga" style="display: block; font-size: 0.85em; color: #555; margin-bottom: 8px;">Capacidad de Carga (kg)</label>
                        <input type="number" step="0.01" id="capacidadCarga" name="capacidad_carga" value="{{camion.capacidadCarga}}"
                               style="width: 100%; padding: 12px 15px; border: 1px solid #ccc; border-radius: 6px; font-size: 1em; box-sizing: border-box; outline: none;">
                    </div>
                    <div style="display: flex; gap: 15px;">
                        <div style="flex: 1;">
                            <label for="capacidadVolumen" style="display: block; font-size: 0.85em; color: #555; margin-bottom: 8px;">Volumen (m³)</label>
                            <input type="number" step="0.01" id="capacidadVolumen" name="capacidad_volumen" value="{{camion.capacidadVolumen}}"
                                   style="width: 100%; padding: 12px 15px; border: 1px solid #ccc; border-radius: 6px; font-size: 1em; box-sizing: border-box; outline: none;">
                        </div>
                        <div style="flex: 1;">
                            <label for="altura" style="display: block; font-size: 0.85em; color: #555; margin-bottom: 8px;">Altura (m)</label>
                            <input type="number" step="0.01" id="altura" name="altura" value="{{camion.altura}}"
                                   style="width: 100%; padding: 12px 15px; border: 1px solid #ccc; border-radius: 6px; font-size: 1em; box-sizing: border-box; outline: none;">
                        </div>
                    </div>
                    <div>
                        <label for="gpsImei" style="display: block; font-size: 0.85em; color: #555; margin-bottom: 8px;">IMEI del GPS Asignado</label>
                        <select id="gpsImei" name="imei_gps"
                                style="width: 100%; padding: 12px 15px; border: 1px solid #ccc; border-radius: 6px; font-size: 1em; box-sizing: border-box; outline: none; background-color: white; cursor: pointer;">
                            <option value="">Sin GPS</option>
                            {{#each gpsDisponibles}}
                                <option value="{{this.imei}}" {{#if (eq this.imei ../camion.imeiGps)}}selected{{/if}}>
                                    {{this.imei}}
                                </option>
                            {{/each}}
                        </select>
                    </div>
                    <!-- Botones -->
                    <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 10px; padding-top: 20px; border-top: 1px solid #f0f0f0;">
                        <button type="submit" style="width: 100%; padding: 12px 0; background-color: #1a1a1a; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.backgroundColor='#333'" onmouseout="this.style.backgroundColor='#1a1a1a'">
                            Actualizar Datos
                        </button>
                        <a href="/camiones" style="width: 100%; padding: 12px 0; text-align: center; color: #1a1a1a; text-decoration: none; font-weight: bold; border-radius: 6px; transition: background 0.2s; box-sizing: border-box;" onmouseover="this.style.backgroundColor='#f0f0f0'" onmouseout="this.style.backgroundColor='transparent'">
                            Cancelar
                        </a>
                    </div>
                </form>
            </section>

        </div>
    </div>
{{/partial}}

{{#partial "scripts"}}
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const lat = parseFloat("{{camion.ultimaLatitud}}");
            const lng = parseFloat("{{camion.ultimaLongitud}}");

            if (!isNaN(lat) && !isNaN(lng)) {
                const zoom = 0.003;
                const bbox = `${lng - zoom},${lat - zoom},${lng + zoom},${lat + zoom}`;
                document.getElementById("mapa-camion").src = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lng}`;
            }
        });
    </script>
{{/partial}}

{{> partials/layout.hbs}}