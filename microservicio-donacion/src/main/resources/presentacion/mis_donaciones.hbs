{{#partial "nombre_pestaña"}}
    Mis donaciones
{{/partial}}

{{#partial "breadcrumbs"}}
    <span>Inicio</span>
    <span>Mis donaciones</span>
{{/partial}}

{{#partial "contenido_propio"}}
    <h1>Mis donaciones</h1>

    {{#if donaciones}}
        <div class="lista-donaciones">
            {{#each donaciones}}
                <article class="donacion-card">
                    <h2>{{descripcion}}</h2>

                    <p>
                        <strong>Estado actual:</strong>
                        {{estadoActual}}
                    </p>

                    <a href="/mis-donaciones/{{id}}">
                        Ver detalle
                    </a>
                </article>
            {{/each}}
        </div>
    {{else}}
        <p>Todavía no tenés donaciones asignadas.</p>
    {{/if}}
{{/partial}}

{{> plantillas/layout.hbs}}