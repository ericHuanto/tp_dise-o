<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#block "nombre_pestaña"}}DonaTrack{{/block}}</title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <!--Espacio para que cada pantalla implemente su propio css-->
    {{#block "css_extra"}}{{/block}}
</head>
<body>
    <!-- HEADER -->
    {{> plantillas/header/header.hbs}}

    <!-- MAIN -->
    <div class="main-wrapper">
        <main>
            {{#block "contenido_propio"}}{{/block}}
        </main>
    </div>

    <!-- FOOTER -->
    {{> plantillas/footer/footer.hbs}}

    <!-- Extra Scripts -->
    {{#block "scripts"}}{{/block}}
</body>
</html>