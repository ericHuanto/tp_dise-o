<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#block "nombre_pestaña"}}DonaTrack{{/block}}</title>
    <!-- Importamos el CSS y la fuente -->
    <link rel="stylesheet" href="/css/landing.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>
<body>

    <header>
        <div class="header-left">
            <div class="logo-footer">
                <div class="icono-logo">D</div>
                <span>DonaTrack</span>
            </div>
            <a href="/beneficiarios/donaciones/recibidas">Ver entregas recibidas</a>
        </div>
        <div class="header-right">
            <a href="/login">Iniciar sesión</a>
            <a href="/registro" class="btn-primary">Registrarse</a>
        </div>
    </header>

    <main>
        {{#block "contenido_propio"}}{{/block}}
    </main>

    <footer>
        <div class="footer">© DonaTrack - Derechos reservados</div>
        <a href="#">Información Legal y Privacidad</a>
    </footer>

    {{#block "scripts"}}{{/block}}

</body>
</html>