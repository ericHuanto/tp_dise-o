<header>
    <div class="header-left">
        <a href="/" class="logo-link">
            <div class="icono-logo">D</div>
            <span>DonaTrack</span>
        </a>
        {{#unless usuario}}
            <a href="/beneficiarios/donaciones/recibidas" class="nav-tab">Ver entregas</a>
        {{/unless}}
    </div>

    {{#if usuario}}
        {{> partials/navbar.hbs}}
        <div class="header-right">
            <form action="/logout" method="POST">
                <button type="submit" class="btn-secondary">Cerrar Sesión</button>
            </form>
        </div>
    {{else}}
        <div class="header-right">
            <a href="/login">Iniciar sesión</a>
            <a href="/perfil/donante-humana" class="btn-primary">Registrarse</a>
        </div>
    {{/if}}
</header>

<!-- Marca como "activo" la pestaña actual -->
<script>
    document.querySelectorAll('.header-left a.nav-tab, .nav-links a').forEach(link => {
        if (link.getAttribute('href') === window.location.pathname) {
            link.classList.add('active');
        }
    });
</script>