{{#partial "nombre_pestaña"}}
    Donaciones entregadas - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="/css/mapa_beneficiarios.css">
{{/partial}}

{{#partial "contenido_propio"}}
<section class="entregas-page">
        <nav class="breadcrumb">
            <a href="/">Inicio</a> <span>›</span> Donaciones entregadas
        </nav>

        <div class="entregas-header">
            <div class="entregas-titulos">
                <h1>Donaciones entregadas</h1>
                <p>Cada punto es una entrega confirmada con foto por la entidad que la recibió.</p>
            </div>

            <div class="entregas-filtros">
                <select id="filtro-periodo" class="filtro-select" onchange="aplicarFiltros()">
                    <option value="">Todos los períodos</option>
                    <option value="30">Últimos 30 días</option>
                    <option value="90">Últimos 3 meses</option>
                </select>

                <select id="filtro-categoria" class="filtro-select" onchange="aplicarFiltros()">
                    <option value="">Todas las categorías</option>
                    {{#each categorias}}
                        <option value="{{this.nombre}}">{{this.nombre}}</option>
                    {{/each}}
                </select>
            </div>
        </div>

        <div class="entregas-grid">
            <div id="mapa" class="mapa-card"></div>

            <aside class="detalle-card">
                <div id="detalle-vacio" class="estado-vacio">
                    <p>Seleccioná un marcador en el mapa para ver el detalle de las donaciones recibidas.</p>
                </div>

                <div id="detalle-contenido" class="oculto">
                    <div class="detalle-top">
                        <span class="badge-estado">● ENTREGADA</span>
                        <span id="detalle-codigo" class="codigo-entrega"></span>
                    </div>

                    <div class="detalle-entidad">
                        <h2 id="detalle-nombre"></h2>
                        <p id="detalle-direccion" class="detalle-subtitulo"></p>
                    </div>

                    <div class="meta-box">
                        <div class="meta-item">
                            <span class="meta-label">Fecha de entrega</span>
                            <span id="detalle-fecha" class="meta-value"></span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Camión</span>
                            <span id="detalle-camion" class="meta-value"></span>
                        </div>
                    </div>

                    <h3 class="seccion-titulo">Bienes entregados</h3>
                    <ul id="detalle-bienes" class="lista-bienes"></ul>

                    <div id="bloque-fotos" class="oculto">
                        <h3 class="seccion-titulo">Fotos de la entrega</h3>
                        <div id="detalle-fotos" class="galeria-fotos"></div>
                    </div>

                    <p id="detalle-pie" class="nota-confirmacion"></p>
                </div>
            </aside>
        </div>
    </section>
{{/partial}}

{{#partial "scripts"}}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const map = L.map('mapa').setView([-34.6037, -58.3816], 11);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
        }).addTo(map);

        const capaMarcadores = L.layerGroup().addTo(map);
        const beneficiarios = JSON.parse('{{{marcadoresJson}}}');

        function mostrarDetalle(beneficiario) {
            document.getElementById('detalle-vacio').classList.add('oculto');
            document.getElementById('detalle-contenido').classList.remove('oculto');

            document.getElementById('detalle-codigo').textContent = beneficiario.codigo || '';
            document.getElementById('detalle-nombre').textContent = beneficiario.razonSocial || '';
            document.getElementById('detalle-direccion').textContent = beneficiario.direccion || '';
            document.getElementById('detalle-fecha').textContent = beneficiario.fechaEntrega || '-';
            document.getElementById('detalle-camion').textContent = beneficiario.camion || '-';

            const listaBienes = document.getElementById('detalle-bienes');
            listaBienes.innerHTML = '';

            if (Array.isArray(beneficiario.donaciones)) {
                beneficiario.donaciones.forEach(donacion => {
                    const li = document.createElement('li');
                    li.className = 'item-bien';

                    const desc = document.createElement('span');
                    desc.textContent = donacion.descripcion;
                    li.appendChild(desc);

                    if (donacion.cantidad !== undefined && donacion.cantidad !== null) {
                        const cant = document.createElement('span');
                        cant.className = 'cantidad-bien';
                        cant.textContent = `× ${donacion.cantidad}`;
                        li.appendChild(cant);
                    }

                    listaBienes.appendChild(li);
                });
            }

            const bloqueFotos = document.getElementById('bloque-fotos');
            const galeriaFotos = document.getElementById('detalle-fotos');
            galeriaFotos.innerHTML = '';

            if (Array.isArray(beneficiario.fotos) && beneficiario.fotos.length > 0) {
                bloqueFotos.classList.remove('oculto');
                beneficiario.fotos.slice(0, 4).forEach((url, i) => {
                    const slot = document.createElement('div');
                    slot.className = 'foto-slot';
                    const img = document.createElement('img');
                    img.src = url;
                    img.alt = `Foto entrega ${i + 1}`;
                    slot.appendChild(img);
                    galeriaFotos.appendChild(slot);
                });
            } else {
                bloqueFotos.classList.add('oculto');
            }

            document.getElementById('detalle-pie').textContent = beneficiario.fechaEntrega
                ? `Recepción confirmada por ${beneficiario.razonSocial} el ${beneficiario.fechaEntrega}.`
                : `Recepción confirmada por ${beneficiario.razonSocial}.`;
        }

        function renderizarMarcadores(lista) {
            capaMarcadores.clearLayers();

            if (lista.length === 0) {
                document.getElementById('detalle-contenido').classList.add('oculto');
                document.getElementById('detalle-vacio').classList.remove('oculto');
                return;
            }

            lista.forEach((beneficiario, index) => {
                const marker = L.marker([
                    parseFloat(beneficiario.latitud),
                    parseFloat(beneficiario.longitud)
                ]).addTo(capaMarcadores);

                marker.bindTooltip(beneficiario.razonSocial);
                marker.on('click', () => mostrarDetalle(beneficiario));

                if (index === 0) {
                    mostrarDetalle(beneficiario);
                }
            });
        }

        function aplicarFiltros() {
            const cat = document.getElementById('filtro-categoria').value.toLowerCase();

            const filtrados = beneficiarios.filter(b => {
                if (!cat) return true;
                return Array.isArray(b.donaciones) && b.donaciones.some(d =>
                    (d.categoria && d.categoria.toLowerCase() === cat) ||
                    (d.descripcion && d.descripcion.toLowerCase().includes(cat))
                );
            });

            renderizarMarcadores(filtrados);
        }

        renderizarMarcadores(beneficiarios);
    </script>
{{/partial}}

