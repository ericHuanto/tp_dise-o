{{#partial "nombre_pestaña"}}
    Resultado Importación - DonaTrack
{{/partial}}

{{#partial "contenido_propio"}}
    <div style="padding: 40px; max-width: 800px; margin: 0 auto;">
        <h1 style="margin-bottom: 5px;">Resultado de la Importación</h1>

        <div style="background-color: #e6f4ea; border: 1px solid #ceead6; padding: 15px; border-radius: 5px; color: #137333; font-weight: bold; margin-bottom: 30px;">
            {{mensaje}}
        </div>

        {{#if errores}}
            <h2 style="color: #d93025; font-size: 1.2em; margin-bottom: 15px;">Se encontraron errores en algunas filas:</h2>

            <table style="width: 100%; border-collapse: collapse; text-align: left; background-color: white; border: 1px solid #e0e0e0; border-radius: 5px; overflow: hidden;">
                <thead style="background-color: #f8d7da; color: #721c24;">
                <tr>
                    <th style="padding: 12px 15px; border-bottom: 1px solid #f5c6cb;">Fila N°</th>
                    <th style="padding: 12px 15px; border-bottom: 1px solid #f5c6cb;">Motivo del Error</th>
                </tr>
                </thead>
                <tbody>
                {{#each errores}}
                    <tr style="border-bottom: 1px solid #eee;">
                        <td style="padding: 12px 15px; font-weight: bold;">{{this.numeroFila}}</td>
                        <td style="padding: 12px 15px; color: #555;">{{this.motivoError}}</td>
                    </tr>
                {{/each}}
                </tbody>
            </table>
        {{else}}
            <div style="padding: 30px; text-align: center; background-color: #f8f9fa; border: 1px dashed #ccc; border-radius: 5px; color: #555;">
                <p style="margin: 0; font-size: 1.1em;"><strong>¡Perfecto!</strong> Todas las filas se importaron correctamente sin ningún error.</p>
            </div>
        {{/if}}

        <div style="margin-top: 30px; text-align: center;">
            <a href="/donantes/importacion" style="display: inline-block; background-color: #1a1a1a; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; font-weight: bold;">
                Volver a importar
            </a>
        </div>
    </div>
{{/partial}}

{{> plantillas/layout.hbs}}