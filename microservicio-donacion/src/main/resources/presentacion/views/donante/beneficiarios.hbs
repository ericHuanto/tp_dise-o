{{#partial "nombre_pestaña"}}
    Entidades beneficiarias - DonaTrack
{{/partial}}

{{#partial "breadcrumbs"}}
    <a href="/">Inicio</a> &gt; <span>Entidades beneficiarias</span>
{{/partial}}

{{#partial "contenido_propio"}}
    <h1>Entidades beneficiarias</h1>

    <table>
        <thead>
            <tr>
                <th>Razón social</th>
                <th>Dirección</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {{#each beneficiarios}}
                <tr>
                    <td>{{razonSocial}}</td>
                    <td>{{direccion}}</td>
                    <td><a href="/donante/beneficiarios/{{id}}">Ver más</a></td>
                </tr>
            {{else}}
                <tr><td colspan="3">No hay entidades registradas.</td></tr>
            {{/each}}
        </tbody>
    </table>
{{/partial}}

{{> partials/layout.hbs}}
