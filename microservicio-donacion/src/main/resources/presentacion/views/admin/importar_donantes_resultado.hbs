{{#partial "nombre_pestaña"}}
    Resultado Importación - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/css/admin/importar_donantes.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <div class="importacion-wrapper">
        <div class="importacion-container">

            <h1 class="importacion-titulo">Importar donantes desde CSV</h1>

            <!-- Pasos -->
            <div class="pasos-container">
                <!-- Paso 1 (Completado) -->
                <div class="paso-item paso-completado">
                    <span class="paso-circulo circulo-exito">✓</span>
                    <span>Subir archivo</span>
                </div>
                <div class="paso-separador"></div>
                <!-- Paso 2 (Completado) -->
                <div class="paso-item paso-completado">
                    <span class="paso-circulo circulo-exito">✓</span>
                    <span>Procesando</span>
                </div>
                <div class="paso-separador"></div>
                <!-- Paso 3 (Actual) -->
                <div class="paso-item paso-final-activo">
                    <span class="paso-circulo circulo-exito">✓</span>
                    <span>Finalizado</span>
                </div>
            </div>

            <!-- Tarjeta de Resultados -->
            <div class="tarjeta-resultados">

                <div class="alerta-exito">
                    Se crearon con éxito {{resultado.cantExitosa}} registros, de los antiguos donantes.
                </div>

                {{#if resultado.erroresEncontrados}}
                    <h2 class="titulo-errores">Se encontraron {{resultado.erroresEncontrados.size}} errores, las filas con error son:</h2>

                    <table class="tabla-errores">
                        <thead>
                        <tr>
                            <th>Fila N°</th>
                            <th>Motivo del Error</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{#each resultado.erroresEncontrados}}
                            <tr>
                                <td class="celda-fila">{{this.numeroFila}}</td>
                                <td class="celda-motivo">{{this.motivoError}}</td>
                            </tr>
                        {{/each}}
                        </tbody>
                    </table>
                    <div class="acciones-errores">
                        <a href="/donantes/importacion" class="btn-otra-importacion">
                            Realizar otra importación
                        </a>
                        <button onclick="descargarErroresCSV()" class="btn-descargar-csv">
                            Descargar reporte de errores (.csv)
                        </button>
                    </div>
                {{else}}
                    <div class="mensaje-sin-errores">
                        <p><strong>¡Perfecto!</strong> Todas las filas se procesaron sin errores y los donantes fueron creados.</p>
                    </div>
                    <div class="acciones-centradas">
                        <a href="/donantes/importacion" class="btn-otra-importacion">
                            Realizar otra importación
                        </a>
                    </div>
                {{/if}}
            </div>

        </div>
    </div>
{{/partial}}

{{#partial "scripts"}}
    <script>
        function descargarErroresCSV() {
            let csvContent = "\uFEFF" + "Fila N°,Motivo del Error\n"; // Cabeceras

            //Las filas de la tabla leídas directamente desde el HTML
            const filas = document.querySelectorAll("tbody tr");
            filas.forEach(row => {
                let filaNum = row.cells[0].innerText;
                let motivo = row.cells[1].innerText.replace(/"/g, '""');
                csvContent += `${filaNum},"${motivo}"\n`;
            });

            //Crear el archivo de texto temporalmente en la memoria del navegador
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);

            const link = document.createElement("a");
            link.setAttribute("href", url);
            link.setAttribute("download", "reporte_errores_importacion.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
{{/partial}}

{{> partials/layout.hbs}}