{{#partial "nombre_pestaña"}}
    Registro Beneficiario - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/css/formularios.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <section class="registro-page">
        <nav class="breadcrumb">
            <a href="/">Inicio</a> <span>›</span> Registro
        </nav>

        <div class="registro-container">
            <h1>Crear una cuenta</h1>
            <p class="subtitulo">Elegí cómo vas a usar DonaTrack.</p>

            <div class="tabs-perfil">
                <a href="/perfil/donante-humana" class="tab-btn">Persona donante</a>
                <a href="/perfil/beneficiario" class="tab-btn active">Entidad beneficiaria</a>
            </div>

            <div class="form-card">
                <form action="/perfil/beneficiario" method="POST">
                    <h3>Datos de la entidad</h3>

                    <div class="form-group">
                        <label for="razon_social">Razón social</label>
                        <input type="text" id="razon_social" name="razonSocial" placeholder="Comedor Los Pibes" required>
                    </div>

                    <div class="form-group">
                        <label for="direccion">Dirección física</label>
                        <input type="text" id="direccion" name="direccion" placeholder="Av. Rivadavia 10000, CABA" required>
                    </div>

                    <hr class="divisor-seccion">

                    <h3>Contacto principal</h3>

                    <div class="form-row">
                        <div class="form-group col-medio">
                            <label for="medio_principal">Medio</label>
                            <select id="medio_principal" name="medio_principal" required>
                                <option value="EMAIL">Email</option>
                                <option value="WHATSAPP">WhatsApp</option>
                                <option value="SMS">SMS</option>
                            </select>
                        </div>
                        <div class="form-group col-valor">
                            <label for="valor_principal">Valor</label>
                            <input type="text" id="valor_principal" name="valor_principal" placeholder="contacto@entidad.org" required>
                        </div>
                    </div>

                    <div id="contenedor-contactos"></div>
                    <button type="button" class="btn-texto-verde" onclick="agregarContacto()">+ Agregar contacto adicional</button>

                    <hr class="divisor-seccion">

                    <h3>Cuenta</h3>

                    <div class="form-group">
                        <label for="nombre_usuario">Usuario</label>
                        <input type="text" id="nombre_usuario" name="name" class="input-mono" placeholder="comedor_lospibes" value="{{usuario.nombreUsuario}}" required>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="contrasenia">Contraseña</label>
                            <input type="password" id="contrasenia" name="password" required>
                        </div>
                        <div class="form-group">
                            <label for="repetir_contrasenia">Repetir contraseña</label>
                            <input type="password" id="repetir_contrasenia" name="passwordConfirm" required>
                        </div>
                    </div>
                    <p class="ayuda-input">Mínimo 8 caracteres, con al menos un número.</p>

                    <div id="alerta-registro" class="alerta-error-login oculto"></div>

                    <div class="registro-footer">
                        <p>¿Ya tenés cuenta? <a href="/login">Iniciá sesión</a></p>
                        <button type="submit" class="btn-crear-cuenta">Crear cuenta</button>
                    </div>
                </form>
            </div>
        </div>
    </section>
{{/partial}}

{{#partial "scripts"}}
    <script>
        function agregarContacto() {
            const contenedor = document.getElementById('contenedor-contactos');
            const nuevaFila = document.createElement('div');
            nuevaFila.className = 'contacto-row';

            nuevaFila.innerHTML = `
                <select name="medios[]" class="col-medio" required>
                    <option value="EMAIL">Email</option>
                    <option value="WHATSAPP">WhatsApp</option>
                    <option value="SMS">SMS</option>
                </select>
                <input type="text" name="valores[]" class="col-valor" placeholder="Nuevo contacto" required>
                <select name="principales[]" class="col-tipo">
                    <option selected value="false">Secundario</option>
                    <option value="true">Es Principal</option>
                </select>
                <button type="button" class="btn-peligro" onclick="this.parentElement.remove()">✕</button>
            `;

            contenedor.appendChild(nuevaFila);
        }

        const params = new URLSearchParams(window.location.search);
        if (params.has('error')) {
            const alerta = document.getElementById('alerta-registro');
            alerta.textContent = params.get('error').replaceAll('_', ' ');
            alerta.classList.remove('oculto');
        }
    </script>
{{/partial}}

{{> partials/layout.hbs}}