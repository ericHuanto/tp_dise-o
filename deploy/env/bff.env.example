# ===== BFF =====
DB_URL_BFF=jdbc:mysql://mysql:3306/donatrack_usuarios?serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USER=
DB_PASSWORD=

PUERTO_BFF=8080

# Clientes gRPC: nombres de los contenedores dentro de la red de Docker
HOST_GRPC_DONACIONES=donaciones
PUERTO_GRPC_DONACIONES=7072
HOST_GRPC_LOGISTICA=logistica
PUERTO_GRPC_LOGISTICA=7073

# Usuario administrador inicial
ADMIN_USUARIO=
ADMIN_PASSWORD=

# Carpeta (dentro del contenedor) donde está montado el volumen de fotos de logística
DIRECTORIO_FOTOS=/app/uploads

TZ=America/Argentina/Buenos_Aires
