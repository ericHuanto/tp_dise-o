{{#partial "nombre_pestaña"}}
    Asignaciones - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/donaciones/css/admin/donaciones.css">
    <link rel="stylesheet" href="/donaciones/css/admin/asignaciones.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <section class="pagina-admin pagina-asignacion">
        <nav class="breadcrumb"><a href="/home">Inicio</a><span>›</span>Asignaciones</nav>

        <h1>Asignaciones</h1>
        <p class="subtitulo">Donaciones pendientes de asignación, con el ranking de entidades candidatas que calculó el sistema.</p>

        {{#if asignadaCodigo}}
            <p class="aviso-ok" role="status">La donación {{asignadaCodigo}} fue asignada correctamente.</p>
        {{/if}}

        <div class="tabla-scroll">
            <table class="tabla tabla-asignaciones">
                <thead>
                <tr>
                    <th>Código</th>
                    <th>Donación</th>
                    <th>Ranking calculado</th>
                    <th>Candidatas</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {{#each rankings}}
                    <tr>
                        <td class="mono codigo">{{this.donacion.codigo}}</td>
                        <td><strong>{{this.donacion.descripcion}}</strong></td>
                        <td class="mono">{{this.fechaGeneracion}}</td>
                        <td class="mono">{{this.cantCandidatos}}</td>
                        <td><span class="estado estado-{{this.donacion.estadoClave}}">{{this.donacion.estadoTexto}}</span></td>
                        <td class="celda-accion"><a class="btn-elegir" href="/asignaciones/{{this.id}}">Elegir entidad →</a></td>
                    </tr>
                {{else}}
                    <tr><td colspan="6" class="vacio">No hay donaciones pendientes de asignación. Los rankings se calculan todas las noches.</td></tr>
                {{/each}}
                </tbody>
            </table>
        </div>
    </section>
{{/partial}}

{{> comun/partials/layout.hbs}}