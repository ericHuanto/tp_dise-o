{{#partial "nombre_pestaña"}}
    Asignar beneficiaria - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/donaciones/css/admin/donaciones.css">
    <link rel="stylesheet" href="/donaciones/css/admin/asignaciones.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <section class="pagina-admin pagina-asignacion">
        <nav class="breadcrumb">
            <a href="/home">Inicio</a><span>›</span><a href="/asignaciones">Asignaciones</a><span>›</span>{{donacion.codigo}}
        </nav>

        <h1>Asignar beneficiaria
            <span class="mono codigo-titulo">{{donacion.codigo}}</span>
            <span class="estado estado-{{donacion.estadoClave}}">{{donacion.estadoTexto}}</span>
        </h1>

        <form action="/asignaciones/{{ranking.id}}" method="POST">
            <input type="hidden" name="id_donacion" value="{{donacion.id}}">

            <div class="asignar-grid">
                <aside class="tarjeta tarjeta-donacion">
                    <h2>Donación</h2>

                    {{#each donacion.bienes}}
                        <div class="bien-bloque">
                            <h3>{{this.descripcion}}</h3>
                            <p class="bien-categoria">{{this.categoria}} › {{this.subcategoria}}</p>
                            <dl class="datos">
                                <dt>Cantidad</dt><dd class="mono">{{this.cantidad}} {{this.unidadMedida}}</dd>
                            </dl>
                        </div>
                    {{/each}}

                    <dl class="datos datos-donacion">
                        <dt>Ingreso</dt><dd class="mono">{{donacion.fechaIngreso}}</dd>
                        {{#if donacion.vencimiento}}
                            <dt>Vence</dt><dd class="mono">{{donacion.vencimiento}}</dd>
                        {{/if}}
                        <dt>Donantes</dt>
                        <dd>{{#each donacion.donantes}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</dd>
                    </dl>
                </aside>

                <section class="tarjeta tarjeta-tabla">
                    <div class="tarjeta-cabecera">
                        <div>
                            <h2>Entidades candidatas</h2>
                            <p class="subtitulo">Ranking calculado el <span class="mono">{{ranking.fechaGeneracion}}</span></p>
                        </div>
                    </div>

                    <div class="tabla-scroll">
                        <table class="tabla tabla-candidatas">
                            <thead>
                            <tr>
                                <th>#</th>
                                <th>Entidad</th>
                                <th>Necesidades que cubre</th>
                            </tr>
                            </thead>
                            <tbody>
                            {{#each candidatos}}
                                <tr>
                                    <td class="celda-radio">
                                        <label>
                                            <input type="radio" name="id_beneficiario" value="{{this.idBeneficiario}}"
                                                   data-nombre="{{this.razonSocial}}" data-pos="{{this.posicionTexto}}"
                                                   {{#if @first}}checked{{/if}} {{#unless ../pendiente}}disabled{{/unless}} required>
                                            <span class="mono posicion">{{this.posicionTexto}}</span>
                                        </label>
                                    </td>
                                    <td><strong>{{this.razonSocial}}</strong>
                                        <small>{{this.direccion}}</small></td>
                                    <td>
                                        {{#each this.necesidades}}
                                            <div class="necesidad">
                                                <span class="necesidad-texto">{{this.descripcion}} · faltan {{this.faltante}} {{this.unidad}}</span>
                                                <span class="urgencia urgencia-{{this.tipoClave}}">{{this.tipoTexto}}</span>
                                            </div>
                                        {{else}}
                                            <small>Sin necesidades registradas para estos bienes</small>
                                        {{/each}}
                                    </td>
                                </tr>
                            {{else}}
                                <tr><td colspan="3" class="vacio">El ranking no tiene entidades candidatas.</td></tr>
                            {{/each}}
                            </tbody>
                        </table>
                    </div>
                    <p class="criterio-nota">Orden según los algoritmos de compatibilidad semántica y prioridad a entidades sub-atendidas.</p>
                </section>
            </div>

            {{#if pendiente}}
                <div class="barra-seleccion">
                    <p>Entidad seleccionada: <strong id="seleccionNombre"></strong>
                        · posición <span class="mono" id="seleccionPos"></span> del ranking</p>
                    <div>
                        <a href="/asignaciones" class="btn-secondary">Volver</a>
                        <button type="submit" class="btn-primary">Confirmar asignación</button>
                    </div>
                </div>
            {{else}}
                <div class="barra-seleccion">
                    <p>{{#if beneficiariaAsignada}}Esta donación ya fue asignada a <strong>{{beneficiariaAsignada}}</strong>.{{else}}Este ranking ya no está vigente.{{/if}}</p>
                    <a href="/asignaciones" class="btn-secondary">Volver</a>
                </div>
            {{/if}}
        </form>
    </section>
{{/partial}}

{{#partial "scripts"}}
    <script>
        const nombre = document.getElementById('seleccionNombre');
        const pos = document.getElementById('seleccionPos');

        function actualizarSeleccion() {
            const r = document.querySelector('input[name="id_beneficiario"]:checked');
            if (!r || !nombre) return;
            nombre.textContent = r.dataset.nombre;
            pos.textContent = r.dataset.pos;
        }

        // Clic en cualquier parte de la fila = elegir esa entidad
        document.querySelectorAll('.tabla-candidatas tbody tr').forEach(fila => {
            fila.addEventListener('click', () => {
                const radio = fila.querySelector('input[name="id_beneficiario"]');
                if (!radio || radio.disabled || radio.checked) return;
                radio.checked = true;
                actualizarSeleccion();
            });
        });

        document.querySelectorAll('input[name="id_beneficiario"]')
            .forEach(r => r.addEventListener('change', actualizarSeleccion));
        actualizarSeleccion();
    </script>
{{/partial}}

{{> comun/partials/layout.hbs}}