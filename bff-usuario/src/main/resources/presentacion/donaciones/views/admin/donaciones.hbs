{{#partial "nombre_pestaña"}}
    Donaciones - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/comun/css/formularios.css">
    <link rel="stylesheet" href="/donaciones/css/admin/donaciones.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <section class="pagina-admin">
        <nav class="breadcrumb"><a href="/home">Inicio</a><span>›</span>Donaciones</nav>

        <div class="pagina-cabecera">
            <div>
                <h1>Donaciones</h1>
                <p class="subtitulo">{{total}} donaciones</p>
            </div>
            <a href="/registros-entrega/nueva" class="btn-primary">+ Registrar entrega</a>
        </div>

        {{#if vencidaCodigo}}
            <p class="aviso-ok" role="status">La donación {{vencidaCodigo}} quedó marcada como vencida.</p>
        {{/if}}
        {{#if creadas}}
            <p class="aviso-ok" role="status">Entrega registrada. Donaciones creadas en depósito: {{creadas}}.</p>
        {{/if}}

        <form class="filtros" action="/donaciones" method="GET">
            <div class="buscador">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
                </svg>
                <input type="search" name="q" value="{{q}}" placeholder="Buscar por código, bien o donante" aria-label="Buscar donaciones">
            </div>
            <select name="estado" aria-label="Estado" onchange="this.form.submit()">
                {{#each estados}}
                    <option value="{{this.valor}}" {{#if this.seleccionado}}selected{{/if}}>Estado: {{this.texto}}</option>
                {{/each}}
            </select>
            <select name="categoria" aria-label="Categoría" onchange="this.form.submit()">
                {{#each categorias}}
                    <option value="{{this.valor}}" {{#if this.seleccionado}}selected{{/if}}>Categoría: {{this.texto}}</option>
                {{/each}}
            </select>
            <select name="vencimiento" aria-label="Vencimiento" onchange="this.form.submit()">
                {{#each vencimientos}}
                    <option value="{{this.valor}}" {{#if this.seleccionado}}selected{{/if}}>Vencimiento: {{this.texto}}</option>
                {{/each}}
            </select>
            <noscript><button type="submit">Filtrar</button></noscript>
        </form>

        <div class="tabla-scroll">
            <table class="tabla">
                <thead>
                <tr>
                    <th>Código</th>
                    <th>Ingreso</th>
                    <th>Donante</th>
                    <th>Bienes</th>
                    <th>Cantidad</th>
                    <th>Vencimiento</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {{#each donaciones}}
                    <tr>
                        <td class="mono codigo">{{this.codigo}}</td>
                        <td class="mono">{{this.fechaIngreso}}</td>
                        <td>
                            {{#each this.donantes}}
                                <div>{{this}}</div>
                            {{else}}
                                <span class="sin-dato">Sin donante</span>
                            {{/each}}
                        </td>
                        <td>
                            <ul class="bienes">
                                {{#each this.bienes}}
                                    <li>
                                        <span>{{this.descripcion}}
                                            <small>{{this.categoria}} › {{this.subcategoria}}</small>
                                        </span>
                                    </li>
                                {{/each}}
                            </ul>
                        </td>
                        <td>
                            <ul class="bienes">
                                {{#each this.bienes}}
                                    <li class="mono">{{this.cantidad}} {{this.unidadMedida}}</li>
                                {{/each}}
                            </ul>
                        </td>
                        <td>
                            {{#if this.vencimiento}}
                                <span class="venc venc-{{this.vencimientoNivel}} mono">{{this.vencimiento}}</span>
                                <small class="venc-{{this.vencimientoNivel}}">{{this.vencimientoTexto}}</small>
                            {{else}}
                                <span class="sin-venc">No perecedero</span>
                            {{/if}}
                        </td>
                        <td><span class="estado estado-{{this.estadoClave}}">{{this.estadoTexto}}</span></td>
                        <td class="celda-accion">
                            {{#if this.vencible}}
                                <form action="/donaciones/{{this.id}}/vencido" method="POST"
                                      data-confirm="La donación {{this.codigo}} agrupa todos los bienes de su fila{{#if this.vencimiento}} (vencen el {{this.vencimiento}}){{/if}}. Al marcarla como vencida no podrá asignarse ni entregarse. Esta acción no se puede deshacer. ¿Confirmás?"
                                      onsubmit="return confirm(this.dataset.confirm)">
                                    <button type="submit" class="btn-vencida">Marcar vencida</button>
                                </form>
                            {{/if}}
                        </td>
                    </tr>
                {{else}}
                    <tr><td colspan="8" class="vacio">No hay donaciones que coincidan con la búsqueda.</td></tr>
                {{/each}}
                </tbody>
            </table>

            {{#if total}}
                <div class="paginacion">
                    <span>Mostrando {{desde}}–{{hasta}} de {{total}}</span>
                    <div class="paginacion-botones">
                        {{#if urlAnterior}}
                            <a href="{{urlAnterior}}" class="btn-pagina">Anterior</a>
                        {{else}}
                            <span class="btn-pagina deshabilitado" aria-disabled="true">Anterior</span>
                        {{/if}}
                        {{#if urlSiguiente}}
                            <a href="{{urlSiguiente}}" class="btn-pagina">Siguiente</a>
                        {{else}}
                            <span class="btn-pagina deshabilitado" aria-disabled="true">Siguiente</span>
                        {{/if}}
                    </div>
                </div>
            {{/if}}
        </div>
    </section>
{{/partial}}

{{> comun/partials/layout.hbs}}