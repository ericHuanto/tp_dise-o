{{#partial "nombre_pestaña"}}
    Iniciar sesión - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/donaciones/css/formularios.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <section class="login-wrapper">
        <div class="form-card login-card">
            <div class="icono-logo login-logo">D</div>

            <h2>Iniciar sesión</h2>
            <p class="subtitulo">Un único acceso para personas donantes, entidades beneficiarias y administración.</p>

            <form action="/login" method="post">
                {{#if mensajeExito}}
                    <div class="alerta-exito" style="color: green; background-color: #e6f4ea; padding: 10px; border-radius: 5px; margin-bottom: 15px;">
                        {{mensajeExito}}
                    </div>
                {{/if}}

                <div class="form-group">
                    <label for="nombre_usuario">Usuario</label>
                    <input type="text" id="nombre_usuario" name="name" class="input-mono" placeholder="eric ..." value="{{nombreEscritoAnteriormente}}" required>
                </div>

                <div class="form-group">
                    <div class="label-row">
                        <label for="contrasenia">Contraseña</label>
                        <button type="submit" formaction="/solicitacion-pin" formnovalidate class="link-olvido btn-link" tabindex="-1"> ¿Olvidaste la contraseña? </button>
                    </div>
                    <input type="password" id="contrasenia" name="password" required>
                </div>

                {{#if mensajeError}}
                    <div class="alerta-error-login"> {{mensajeError}} </div>
                {{/if}}

                <button type="submit" class="btn-submit">Ingresar</button>
            </form>

            <div class="login-footer">
                <p>¿No tienes cuenta? <a href="/perfil/donante-humana">Registrate</a></p>
            </div>
        </div>
    </section>
{{/partial}}

{{> donaciones/partials/layout.hbs}}