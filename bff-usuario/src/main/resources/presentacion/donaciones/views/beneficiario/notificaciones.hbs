{{#partial "nombre_pestaña"}}
    Historial - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/comun/css/formularios.css">
    <link rel="stylesheet" href="/donaciones/css/beneficiario/notificaciones.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <section class="historial">

        <nav class="breadcrumb"><a href="/home">Inicio</a><span>›</span>Historial</nav>

        <div class="historial-encabezado">
            <div>
                <h1>Historial</h1>
                <p>Consultá los movimientos y cambios de estado de tus donaciones asignadas.</p>
            </div>
        </div>

        {{#if novedades}}
            <div class="historial-filtros">
                <button type="button" class="filtro-historial activo" data-estado="TODAS">
                    Todos
                </button>
                <button type="button" class="filtro-historial" data-estado="ASIGNACION_REALIZADA">
                    Asignada
                </button>
                <button type="button" class="filtro-historial" data-estado="LISTA_PARA_ENTREGAR">
                    Preparando entrega
                </button>
                <button type="button" class="filtro-historial" data-estado="EN_TRASLADO">
                    En traslado
                </button>
                <button type="button" class="filtro-historial" data-estado="ENTREGADA">
                    Entregada
                </button>
                <button type="button" class="filtro-historial" data-estado="ENTREGA_FALLIDA">
                    Entrega fallida
                </button>
            </div>

            <div class="historial-lista">
                {{#each novedades}}
                    <article class="historial-item" data-estado="{{tipoEstado}}">
                        <div class="historial-icono">
                            <span class="historial-inicial">D</span>
                        </div>

                        <div class="historial-informacion">
                            <span class="historial-tipo" data-estado="{{tipoEstado}}">
                                {{tipoEstado}}
                            </span>

                            <h3>Donación #{{idDonacion}}</h3>

                            <p>{{descripcion}}</p>

                            {{#if detalle}}
                                <p class="historial-detalle">{{detalle}}</p>
                            {{/if}}
                        </div>

                        <div class="historial-derecha">
                            <span class="historial-fecha">{{fecha}}</span>

                            <a href="/mis-donaciones/{{idDonacion}}">
                                Ver donación
                            </a>
                        </div>
                    </article>
                {{/each}}
            </div>

            <p class="historial-sin-resultados" id="historial-sin-resultados" hidden>
                No hay movimientos para este filtro.
            </p>
        {{else}}
            <div class="historial-vacio">
                <h2>No hay movimientos registrados</h2>
                <p>Todavía no tenés novedades sobre tus donaciones.</p>
            </div>
        {{/if}}
    </section>
{{/partial}}

{{#partial "scripts"}}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const botonesFiltro = document.querySelectorAll(".filtro-historial");
            const movimientos = document.querySelectorAll(".historial-item");
            const mensajeVacio = document.getElementById("historial-sin-resultados");

            const nombresEstados = {
                ASIGNACION_REALIZADA: "Asignada",
                LISTA_PARA_ENTREGAR: "Preparando entrega",
                EN_TRASLADO: "En traslado",
                ENTREGADA: "Entregada",
                ENTREGA_FALLIDA: "Entrega fallida"
            };

            document.querySelectorAll(".historial-tipo").forEach(etiqueta => {
                const estado = (etiqueta.dataset.estado || "").trim().toUpperCase();
                etiqueta.textContent = nombresEstados[estado] || etiqueta.dataset.estado;
            });

            botonesFiltro.forEach(boton => {
                boton.addEventListener("click", () => {
                    const estadoFiltro = boton.dataset.estado;
                    let visibles = 0;

                    botonesFiltro.forEach(b => b.classList.remove("activo"));
                    boton.classList.add("activo");

                    movimientos.forEach(movimiento => {
                        const estadoItem = (movimiento.dataset.estado || "").trim().toUpperCase();
                        const mostrar = estadoFiltro === "TODAS" || estadoItem === estadoFiltro;

                        movimiento.hidden = !mostrar;

                        if (mostrar) {
                            visibles++;
                        }
                    });

                    if (mensajeVacio) {
                        mensajeVacio.hidden = visibles > 0;
                    }
                });
            });
        });
    </script>
{{/partial}}

{{> comun/partials/layout.hbs}}