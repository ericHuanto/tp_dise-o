
{{#partial "nombre_pestaña"}}
    Historial
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/donaciones/css/beneficiario/notificaciones.css">
{{/partial}}

{{#partial "breadcrumbs"}}
    <span>Inicio</span>
    <span>Historial</span>
{{/partial}}

{{#partial "contenido_propio"}}

    <section class="historial">

        <div class="historial-encabezado">
            <div>
                <h1>Historial</h1>
                <p>Consultá los movimientos y cambios de estado de tus donaciones asignadas.</p>
            </div>
        </div>

        {{#if novedades}}

            <div class="historial-filtros">
                <button type="button" class="filtro-historial activo" data-filtro="todos">
                    Todos
                </button>
                <button type="button" class="filtro-historial" data-filtro="asignacion">
                    Asignaciones
                </button>
                <button type="button" class="filtro-historial" data-filtro="recepcion">
                    Recepciones
                </button>
                <button type="button" class="filtro-historial" data-filtro="otros">
                    Otros
                </button>
            </div>

            <div class="historial-lista">

                {{#each novedades}}

                    <article class="historial-item" data-estado="{{tipoEstado}}">

                        <div class="historial-icono">
                            <span class="historial-inicial">D</span>
                        </div>

                        <div class="historial-informacion">

                        <span class="historial-tipo">
                            {{tipoEstado}}
                        </span>

                            <h3>Donación #{{idDonacion}}</h3>

                            <p>{{descripcion}}</p>

                            {{#if detalle}}
                                <p class="historial-detalle">{{detalle}}</p>
                            {{/if}}

                        </div>

                        <div class="historial-derecha">

                        <span class="historial-fecha">
                            {{fecha}}
                        </span>

                            <a href="/mis-donaciones/{{idDonacion}}">
                                Ver donación
                            </a>

                        </div>

                    </article>

                {{/each}}

            </div>

            <p class="historial-sin-resultados" id="historial-sin-resultados" hidden>
                No hay movimientos para este filtro.
            </p>

        {{else}}

            <div class="historial-vacio">
                <h2>No hay movimientos registrados</h2>
                <p>Todavía no tenés novedades sobre tus donaciones.</p>
            </div>

        {{/if}}

    </section>

{{/partial}}

{{#partial "scripts"}}
    <script>
        const botonesFiltro = document.querySelectorAll(".filtro-historial");
        const movimientos = document.querySelectorAll(".historial-item");
        const mensajeVacio = document.getElementById("historial-sin-resultados");

        botonesFiltro.forEach(boton => {
            boton.addEventListener("click", () => {
                const filtro = boton.dataset.filtro;
                let visibles = 0;

                botonesFiltro.forEach(b => b.classList.remove("activo"));
                boton.classList.add("activo");

                movimientos.forEach(movimiento => {
                    const estado = (movimiento.dataset.estado || "").toUpperCase();

                    const esAsignacion = estado.includes("ASIGN");
                    const esRecepcion = estado.includes("RECIB")
                            || estado.includes("RECEP")
                            || estado.includes("ENTREG");

                    const mostrar =
                            filtro === "todos" ||
                            (filtro === "asignacion" && esAsignacion) ||
                            (filtro === "recepcion" && esRecepcion) ||
                            (filtro === "otros" && !esAsignacion && !esRecepcion);

                    movimiento.hidden = !mostrar;

                    if (mostrar) {
                        visibles++;
                    }
                });

                if (mensajeVacio) {
                    mensajeVacio.hidden = visibles > 0;
                }
            });
        });
    </script>
{{/partial}}

{{> comun/partials/layout.hbs}}
