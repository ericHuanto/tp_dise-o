{{#partial "nombre_pestaña"}}
    Entregas asignadas - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/comun/css/formularios.css">
    <link rel="stylesheet" href="/donaciones/css/admin/donaciones.css">
    <link rel="stylesheet" href="/donaciones/css/donante/donaciones.css">
    <link rel="stylesheet" href="/donaciones/css/beneficiario/donaciones_asignadas.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <section class="pagina-admin pagina-donante pagina-beneficiario">
        <nav class="breadcrumb"><a href="/home">Inicio</a><span>›</span>Entregas asignadas</nav>

        <h1>Entregas asignadas</h1>
        <p class="subtitulo">Consultá el estado de las entregas asignadas a tu organización.</p>

        <div class="resumen-donaciones">
            <div class="resumen-tarjeta">
                <strong class="mono">{{resumen.total}}</strong>
                <span>Asignadas</span>
            </div>
            <div class="resumen-tarjeta">
                <strong class="mono">{{resumen.entregadas}}</strong>
                <span>Entregadas</span>
            </div>
            <div class="resumen-tarjeta">
                <strong class="mono">{{resumen.enCurso}}</strong>
                <span>En curso</span>
            </div>
            <div class="resumen-tarjeta">
                <strong class="mono">{{resumen.fallidas}}</strong>
                <span>Entrega fallida</span>
            </div>
        </div>

        <form class="filtros filtros-donante" method="GET">
            <div class="filtros-fila">
                <div class="buscador">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
                    </svg>
                    <input type="search" name="q" value="{{q}}" placeholder="Buscar por código, bien o fecha" aria-label="Buscar entregas asignadas">
                </div>

                <select name="estado" aria-label="Estado" onchange="this.form.submit()">
                    {{#each estados}}
                        <option value="{{this.valor}}" {{#if this.seleccionado}}selected{{/if}}>Estado: {{this.texto}}</option>
                    {{/each}}
                </select>

                {{#if hayFiltros}}
                    <a href="{{urlLimpiar}}" class="btn-link limpiar">Limpiar filtros</a>
                {{/if}}
                <noscript><button type="submit" class="btn-secondary">Filtrar</button></noscript>
            </div>
        </form>

        <div class="tabla-scroll">
            <table class="tabla tabla-donaciones">
                <thead>
                <tr>
                    <th>Código</th>
                    <th>Fecha de asignación</th>
                    <th>Bienes</th>
                    <th>Estado</th>
                    <th class="celda-accion">Acciones</th>
                </tr>
                </thead>
                <tbody>
                {{#each donaciones}}
                    <tr>
                        <td class="mono codigo codigo-donacion">{{this.codigo}}</td>
                        <td>{{this.fechaAsignacion}}</td>
                        <td class="descripcion-donacion">{{this.descripcion}}</td>
                        <td>
                            <span class="estado estado-{{this.estadoClave}}">
                                {{this.estadoTexto}}
                            </span>
                        </td>
                        <td class="celda-accion">
                            <a href="/mis-donaciones/{{this.id}}" class="btn-link accion-detalle">
                                Ver detalle
                            </a>
                        </td>
                    </tr>
                {{else}}
                    <tr>
                        <td colspan="5" class="vacio">
                            {{#if hayFiltros}}
                                No hay entregas que coincidan con los filtros.
                            {{else}}
                                Todavía no tenés entregas asignadas.
                            {{/if}}
                        </td>
                    </tr>
                {{/each}}
                </tbody>
            </table>

            {{#if total}}
                <div class="paginacion">
                    <span>Mostrando {{desde}}–{{hasta}} de {{total}} entregas</span>
                    <div class="paginacion-botones">
                        {{#if urlAnterior}}
                            <a href="{{urlAnterior}}" class="btn-pagina">Anterior</a>
                        {{else}}
                            <span class="btn-pagina deshabilitado" aria-disabled="true">Anterior</span>
                        {{/if}}
                        {{#if urlSiguiente}}
                            <a href="{{urlSiguiente}}" class="btn-pagina">Siguiente</a>
                        {{else}}
                            <span class="btn-pagina deshabilitado" aria-disabled="true">Siguiente</span>
                        {{/if}}
                    </div>
                </div>
            {{/if}}
        </div>
    </section>
{{/partial}}

{{> comun/partials/layout.hbs}}