{{#partial "nombre_pestaña"}}
    Seguimiento de entregas - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="/comun/css/formularios.css">
    <link rel="stylesheet" href="/donaciones/css/admin/donaciones.css">
    <link rel="stylesheet" href="/donaciones/css/donante/seguimiento.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <section class="pagina-admin pagina-seguimiento">
        <nav class="breadcrumb"><a href="/">Inicio</a><span>›</span>Seguimiento</nav>

        <div class="pagina-cabecera">
            <div>
                <h1>Seguimiento de entregas</h1>
                <p class="subtitulo">
                    {{#if camiones}}
                        {{donacionesEnCamino}} {{#if (eq donacionesEnCamino 1)}}donación en camino{{else}}donaciones en camino{{/if}}
                        en {{cantidadCamiones}} {{#if (eq cantidadCamiones 1)}}camión{{else}}camiones{{/if}}.
                    {{else}}
                        Seguí en el mapa los camiones que llevan tus donaciones.
                    {{/if}}
                </p>
            </div>
            <a href="/donante/seguimiento" class="btn-secondary">Actualizar</a>
        </div>

        {{#unless logisticaDisponible}}
            <p class="aviso-error" role="alert">No pudimos consultar la ubicación de los camiones. Probá de nuevo en unos minutos.</p>
        {{/unless}}

        <div class="seguimiento-grilla">
            <div id="mapa" class="mapa-seguimiento"></div>

            <aside class="panel-camiones">
                <h2>Camiones en camino</h2>
                {{#each camiones}}
                    <article class="camion-item" data-patente="{{this.patente}}">
                        <div class="camion-item-cabecera">
                            <span class="camion-icono" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/>
                                </svg>
                            </span>
                            <div>
                                <strong class="mono">{{this.patente}}</strong>
                                <small>Última actualización: {{this.ultimaActualizacion}}</small>
                            </div>
                        </div>
                        <ul class="camion-donaciones">
                            {{#each this.donaciones}}
                                <li>{{this}}</li>
                            {{/each}}
                        </ul>
                    </article>
                {{else}}
                    <p class="panel-vacio">Ninguna de tus donaciones está en traslado en este momento.</p>
                {{/each}}
            </aside>
        </div>
    </section>

    <script id="datos-camiones" type="application/json">{{{camionesJson}}}</script>
{{/partial}}

{{#partial "scripts"}}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const mapa = L.map('mapa').setView([-34.6037, -58.3816], 11);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap'
        }).addTo(mapa);

        const camiones = JSON.parse(document.getElementById('datos-camiones').textContent);
        const limites = [];
        const marcadores = {};

        camiones.forEach(camion => {
            const latitud = parseFloat(camion.latitud);
            const longitud = parseFloat(camion.longitud);
            if (!Number.isFinite(latitud) || !Number.isFinite(longitud)) return;

            const popup = document.createElement('div');
            const titulo = document.createElement('strong');
            titulo.textContent = 'Camión ' + camion.patente;
            const actualizacion = document.createElement('div');
            actualizacion.textContent = 'Última actualización: ' + camion.ultimaActualizacion;
            const lista = document.createElement('ul');
            camion.donaciones.forEach(d => {
                const item = document.createElement('li');
                item.textContent = d;
                lista.appendChild(item);
            });
            popup.append(titulo, actualizacion, lista);

            const posicion = [latitud, longitud];
            marcadores[camion.patente] = L.marker(posicion).addTo(mapa).bindPopup(popup);
            limites.push(posicion);
        });

        if (limites.length > 0) {
            mapa.fitBounds(limites, { padding: [40, 40], maxZoom: 15 });
        }

        document.querySelectorAll('.camion-item').forEach(item => {
            item.addEventListener('click', () => {
                const marcador = marcadores[item.dataset.patente];
                if (!marcador) return;
                mapa.setView(marcador.getLatLng(), 15);
                marcador.openPopup();
            });
        });
    </script>
{{/partial}}

{{> comun/partials/layout.hbs}}
