{{#partial "nombre_pestaña"}}
    {{beneficiario.razonSocial}} - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/comun/css/formularios.css">
    <link rel="stylesheet" href="/donaciones/css/admin/donaciones.css">
    <link rel="stylesheet" href="/donaciones/css/donante/beneficiarios.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <section class="pagina-admin pagina-entidades">
        <nav class="breadcrumb">
            <a href="/home">Inicio</a><span>›</span><a href="/donante/beneficiarios">Entidades</a><span>›</span>{{beneficiario.razonSocial}}
        </nav>

        <div class="detalle-entidad-cabecera">
            <span class="avatar-entidad avatar-grande">{{beneficiario.iniciales}}</span>
            <div>
                <h1>{{beneficiario.razonSocial}}</h1>
                <p class="subtitulo">{{beneficiario.direccion}}</p>
            </div>
        </div>

        <div class="detalle-entidad-resumen">
            <div class="necesidad-urgente">
                <span>Necesidad más urgente</span>
                {{#if beneficiario.necesidadUrgente}}
                    <strong>{{beneficiario.necesidadUrgente}}</strong>
                {{else}}
                    <strong class="sin-necesidad">Sin necesidades pendientes</strong>
                {{/if}}
            </div>
            <div class="necesidad-urgente">
                <span>Necesidades activas</span>
                <strong>{{beneficiario.necesidadesActivas}}</strong>
            </div>
        </div>

        <h2 class="titulo-seccion">Necesidades</h2>
        <div class="tabla-scroll">
            <table class="tabla">
                <thead>
                <tr>
                    <th>Necesidad</th>
                    <th>Categoría</th>
                    <th>Tipo</th>
                    <th>Progreso</th>
                </tr>
                </thead>
                <tbody>
                {{#each necesidades}}
                    <tr>
                        <td>{{this.descripcion}}</td>
                        <td>{{this.categoria}} <small>{{this.subcategoria}}</small></td>
                        <td>{{this.tipo}}</td>
                        <td class="celda-progreso">
                            <div class="progreso {{#if this.cubierta}}progreso-completo{{/if}}">
                                <div class="progreso-barra" style="width: {{this.porcentaje}}%"></div>
                            </div>
                            <small class="mono">{{this.recibida}} / {{this.requerida}} {{this.unidad}}</small>
                        </td>
                    </tr>
                {{else}}
                    <tr><td colspan="4" class="vacio">Esta entidad no tiene necesidades cargadas.</td></tr>
                {{/each}}
                </tbody>
            </table>
        </div>

        <a href="/donante/beneficiarios" class="btn-link volver">← Volver a entidades</a>
    </section>
{{/partial}}

{{> comun/partials/layout.hbs}}
