{{#partial "nombre_pestaña"}}
    Error {{codigo}} - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/comun/css/error.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <section class="pagina-error">
        <div class="tarjeta-error">
            <span class="codigo-error">ERROR {{codigo}}</span>
            <h1>{{titulo}}</h1>
            <p class="mensaje-error">{{mensaje}}</p>
            {{#if detalle}}
                <p class="detalle-error">{{detalle}}</p>
            {{/if}}
            <div class="acciones-error">
                <a href="javascript:history.back()" class="btn-secondary">Volver atrás</a>
                <a href="/" class="btn-primary">Ir al inicio</a>
            </div>
        </div>
    </section>
{{/partial}}

{{> comun/partials/layout.hbs}}