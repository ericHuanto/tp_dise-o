{{#partial "nombre_pestaña"}}
    Iniciar sesión - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/comun/css/formularios.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <section class="login-wrapper">
        <div class="form-card login-card">
            <div class="icono-logo login-logo">D</div>

            <h2>Iniciar sesión</h2>
            <p class="subtitulo">Un único acceso para personas donantes, entidades beneficiarias y administración.</p>

            <form action="/login" method="post">
                <button type="submit" tabindex="-1" aria-hidden="true"
                    style="position: absolute; left: -9999px;">Ingresar</button>

                {{#if mensajeExito}}
                    <div class="alerta-exito" style="color: green; background-color: #e6f4ea; padding: 10px; border-radius: 5px; margin-bottom: 15px;">
                        {{mensajeExito}}
                    </div>
                {{/if}}

                <div class="form-group">
                    <label for="nombre_usuario">Usuario</label>
                    <input type="text" id="nombre_usuario" name="name" class="input-mono" placeholder="eric ..." value="{{nombreEscritoAnteriormente}}" required>
                </div>

                <div class="form-group">
                    <div class="label-row">
                        <label for="contrasenia">Contraseña</label>
                        <button type="submit" formaction="/solicitacion-pin" formnovalidate class="link-olvido btn-link" tabindex="-1"> ¿Olvidaste la contraseña? </button>
                    </div>
                    <div class="password-wrapper">
                        <input type="password" id="contrasenia" name="password" required>
                        <button type="button" id="btn-ver-pass" class="btn-ojito" aria-label="Mostrar contraseña" tabindex="-1">
                            <svg id="icono-ojo-abierto" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                            <svg id="icono-ojo-cerrado" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                                <line x1="1" y1="1" x2="23" y2="23"/>
                            </svg>
                        </button>
                    </div>
                </div>

                {{#if mensajeError}}
                    <div class="alerta-error-login"> {{mensajeError}} </div>
                {{/if}}

                <button type="submit" class="btn-submit">Ingresar</button>
            </form>

            <div class="login-footer">
                <p>¿No tienes cuenta? <a href="/perfil/donante-humana">Registrate</a></p>
            </div>
        </div>
    </section>
{{/partial}}

{{#partial "scripts"}}
    <script>
        (function () {
            const input = document.getElementById('contrasenia');
            const btn = document.getElementById('btn-ver-pass');
            const ojoAbierto = document.getElementById('icono-ojo-abierto');
            const ojoCerrado = document.getElementById('icono-ojo-cerrado');

            btn.addEventListener('click', () => {
                const mostrar = input.type === 'password';
                input.type = mostrar ? 'text' : 'password';
                ojoAbierto.style.display = mostrar ? 'none' : 'block';
                ojoCerrado.style.display = mostrar ? 'block' : 'none';
                btn.setAttribute('aria-label', mostrar ? 'Ocultar contraseña' : 'Mostrar contraseña');
            });
        })();
    </script>
{{/partial}}

{{> comun/partials/layout.hbs}}
