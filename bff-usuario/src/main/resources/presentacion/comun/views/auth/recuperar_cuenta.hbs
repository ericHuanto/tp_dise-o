{{#partial "nombre_pestaña"}}
    Recuperar contraseña - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/comun/css/formularios.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <section class="login-wrapper">
        <div class="form-card login-card">
            <div class="icono-logo login-logo">D</div>

            <h2>Recuperar cuenta</h2>
            <p class="subtitulo">Ingresa el código temporal y tu nueva contraseña.</p>

            {{#if informacion}}
                <div class="alerta-exito"> {{informacion}} </div>
            {{/if}}

            {{#if errorFlash}}
                <div class="alerta-error-login"> {{errorFlash}} </div>
            {{/if}}

            <form action="/recuperacion" method="post">
                <input type="hidden" name="nombre_usuario" value="{{nombreUsuario}}">

                <div class="form-group">
                    <label for="pin">Código de recuperación (8 caracteres)</label>
                    <input type="text" id="pin" name="pin" class="input-mono" required>
                </div>

                <div class="form-group">
                    <label for="new_password">Nueva contraseña</label>
                    <input type="password" id="new_password" name="new_password" required>
                </div>

                <button type="submit" class="btn-submit">Guardar contraseña</button>
            </form>

            <div class="login-footer">
                <p><a href="/login">Volver al inicio de sesión</a></p>
            </div>
        </div>
    </section>
{{/partial}}

{{> comun/partials/layout.hbs}}