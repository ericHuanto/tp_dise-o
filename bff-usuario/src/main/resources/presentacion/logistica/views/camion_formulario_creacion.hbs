{{#partial "nombre_pestaña"}}
    Nuevo Camión - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/logistica/css/camiones.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <div class="camiones-pagina camiones-pagina--formulario">

        <section class="camion-tarjeta-alta">
            <div class="camion-alta-cabecera">
                <h2>Registrar Nuevo Camión</h2>
                <p>Ingrese los datos técnicos del vehículo</p>
            </div>
            <form action="/camiones" method="POST" class="camion-form">
                <div>
                    <label for="patente" class="camion-label">Patente <span class="obligatorio">*</span></label>
                    <input type="text" id="patente" name="patente" required placeholder="Ej: ABC-123"
                           class="camion-input camion-input--patente">
                </div>
                <div>
                    <label for="capacidadCarga" class="camion-label">Capacidad de Carga (kg) <span class="obligatorio">*</span></label>
                    <input type="number" step="0.01" id="capacidadCarga" name="capacidad_carga" required placeholder="Ej: 1500"
                           class="camion-input">
                </div>
                <div class="camion-form-fila camion-form-fila--ajustable">
                    <div class="camion-form-columna">
                        <label for="capacidadVolumen" class="camion-label">Volumen (m³) <span class="obligatorio">*</span></label>
                        <input type="number" step="0.01" id="capacidadVolumen" name="capacidad_volumen" required placeholder="Ej: 10.5"
                               class="camion-input">
                    </div>
                    <div class="camion-form-columna">
                        <label for="altura" class="camion-label">Altura (m) <span class="obligatorio">*</span></label>
                        <input type="number" step="0.01" id="altura" name="altura" required placeholder="Ej: 2.5"
                               class="camion-input">
                    </div>
                </div>
                <div>
                    <label for="gpsImei" class="camion-label">Asignar GPS (Opcional)</label>
                    <select id="gpsImei" name="imei_gps"
                            class="camion-input">
                        <option value=""> Sin GPS </option>
                        {{#each gpsDisponibles}}
                            <option value="{{this.imei}}">{{this.imei}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="camion-form-acciones">
                    <a href="/camiones" class="btn-camion-cancelar">
                        Cancelar
                    </a>
                    <button type="submit" class="btn-camion-guardar">
                        Guardar Camión
                    </button>
                </div>
            </form>
        </section>
    </div>
{{/partial}}

{{> comun/partials/layout.hbs}}