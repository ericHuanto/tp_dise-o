{{#partial "nombre_pestaña"}}
    Editar Camión - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/logistica/css/camiones.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <div class="camiones-pagina camiones-pagina--centrada">
        <nav class="breadcrumb breadcrumb-camion-edicion"><a href="/home">Inicio</a><span>›</span><a href="/camiones">Camiones</a><span>›</span>Editar {{camion.patente}}</nav>

        <div class="camion-edicion">

            <section class="camion-mapa-seccion">
                <h2>Última ubicación</h2>
                <div class="camion-mapa">
                    <iframe id="mapa-camion" width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0"></iframe>
                </div>
            </section>

            <section class="camion-tarjeta-edicion">
                <div class="camion-edicion-cabecera">
                    <h2>Editar camión</h2>
                    <span class="camion-edicion-patente">{{camion.patente}}</span>
                </div>

                <form action="/camiones/{{camion.patente}}/edicion" method="POST" class="camion-form">
                    <div>
                        <label for="patente" class="camion-label">Patente (No modificable)</label>
                        <input type="text" id="patente" name="patente" value="{{camion.patente}}" readonly
                               class="camion-input camion-input--bloqueado">
                    </div>
                    <div>
                        <label for="capacidadCarga" class="camion-label">Capacidad de Carga (kg)</label>
                        <input type="number" step="0.01" id="capacidadCarga" name="capacidad_carga" value="{{camion.capacidadCarga}}"
                               class="camion-input">
                    </div>
                    <div class="camion-form-fila">
                        <div class="camion-form-columna">
                            <label for="capacidadVolumen" class="camion-label">Volumen (m³)</label>
                            <input type="number" step="0.01" id="capacidadVolumen" name="capacidad_volumen" value="{{camion.capacidadVolumen}}"
                                   class="camion-input">
                        </div>
                        <div class="camion-form-columna">
                            <label for="altura" class="camion-label">Altura (m)</label>
                            <input type="number" step="0.01" id="altura" name="altura" value="{{camion.altura}}"
                                   class="camion-input">
                        </div>
                    </div>
                    <div>
                        <label for="gpsImei" class="camion-label">IMEI del GPS Asignado</label>
                        <select id="gpsImei" name="imei_gps"
                                class="camion-input">
                            <option value="">Sin GPS</option>
                            {{#each gpsDisponibles}}
                                <option value="{{this.imei}}" {{#if (eq this.imei ../camion.imeiGps)}}selected{{/if}}>
                                    {{this.imei}}
                                </option>
                            {{/each}}
                        </select>
                    </div>
                    <!-- Botones -->
                    <div class="camion-form-acciones camion-form-acciones--apiladas">
                        <button type="submit" class="btn-camion-guardar">
                            Actualizar Datos
                        </button>
                        <a href="/camiones" class="btn-camion-cancelar">
                            Cancelar
                        </a>
                    </div>
                </form>
            </section>

        </div>
    </div>
{{/partial}}

{{#partial "scripts"}}
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const lat = parseFloat("{{camion.ultimaLatitud}}");
            const lng = parseFloat("{{camion.ultimaLongitud}}");

            if (!isNaN(lat) && !isNaN(lng)) {
                const zoom = 0.003;
                const bbox = `${lng - zoom},${lat - zoom},${lng + zoom},${lat + zoom}`;
                document.getElementById("mapa-camion").src = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lng}`;
            }
        });
    </script>
{{/partial}}

{{> comun/partials/layout.hbs}}