{{#partial "nombre_pestaña"}}
    Gestión de Camiones - DonaTrack
{{/partial}}

{{#partial "css_extra"}}
    <link rel="stylesheet" href="/logistica/css/camiones.css">
{{/partial}}

{{#partial "contenido_propio"}}
    <div class="camiones-pagina">

        <div class="camiones-cabecera">
            <h1 class="camiones-titulo">Camiones</h1>
            <a href="/camiones/nuevo" class="camiones-btn-nuevo">
                + Registrar Camión
            </a>
        </div>

        <!-- Métricas (KPIs) -->
        <div class="camiones-kpis">
            <div class="camiones-kpi">
                <div class="camiones-kpi-valor">{{totalCamiones}}</div>
                <div class="camiones-kpi-etiqueta">Camiones Totales</div>
            </div>
            <div class="camiones-kpi">
                <div class="camiones-kpi-valor">{{camionesEnRuta}}</div>
                <div class="camiones-kpi-etiqueta">Camiones en Ruta ahora</div>
            </div>
            <div class="camiones-kpi">
                <div class="camiones-kpi-valor">{{camionesSinGps}}</div>
                <div class="camiones-kpi-etiqueta">Camiones sin GPS instalado</div>
            </div>
        </div>

        <div class="camiones-tabla-contenedor">
            <table class="camiones-tabla">
                <thead>
                <tr>
                    <th>Patente</th>
                    <th>Carga</th>
                    <th>Volumen</th>
                    <th>Altura</th>
                    <th>GPS (IMEI)</th>
                    <th>Ubicación Actual</th>
                    <th class="columna-acciones">Acciones</th>
                </tr>
                </thead>
                <tbody>
                {{#each camiones}}
                    <tr class="camion-fila">
                        <td class="celda-patente">{{this.patente}}</td>
                        <td>{{this.capacidadCarga}} kg</td>
                        <td>{{this.capacidadVolumen}} m³</td>
                        <td>{{this.altura}} m</td>
                        <td>
                            {{#if this.imeiGps}}
                                {{this.imeiGps}}
                            {{else}}
                                <span class="sin-gps">Sin GPS</span>
                            {{/if}}
                        </td>
                        <td class="celda-ubicacion" data-lat="{{this.ultimaLatitud}}" data-lng="{{this.ultimaLongitud}}">
                            ...
                        </td>
                        <td class="celda-acciones">
                            <a href="/camiones/{{this.patente}}/edicion" title="Editar camión" class="accion-camion accion-editar">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                            </a>
                            <form action="/camiones/{{this.patente}}/eliminacion" method="post" class="form-eliminar">
                                <button type="submit" title="Eliminar camión" class="accion-camion accion-eliminar">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                {{else}}
                    <tr>
                        <td colspan="7" class="celda-vacia">No hay camiones registrados en el sistema.</td>
                    </tr>
                {{/each}}
                </tbody>
            </table>
        </div>
    </div>
{{/partial}}

{{#partial "scripts"}}
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const celdas = document.querySelectorAll(".celda-ubicacion");

            celdas.forEach(celda => {
                const lat = celda.getAttribute("data-lat");
                const lng = celda.getAttribute("data-lng");

                if (lat && lng && lat !== "null" && lng !== "null") {
                    fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`)
                            .then(response => response.json())
                            .then(data => {
                                celda.innerText = data.address.road ?
                                        `${data.address.road} ${data.address.house_number || ''}, ${data.address.city || data.address.town}` :
                                        data.display_name.split(",")[0];
                            })
                            .catch(() => {
                                celda.innerText = "Error al cargar dirección";
                            });
                } else {
                    celda.innerText = "Sin ubicación";
                }
            });
        });
    </script>
{{/partial}}

{{> comun/partials/layout.hbs}}